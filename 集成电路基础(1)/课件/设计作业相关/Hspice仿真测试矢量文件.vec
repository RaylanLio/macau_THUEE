;==Vector Pattern Definition for 32-bit Adder Testing
; Specifies the number of bits associated with each vector
radix 14444444444444444444444441
; Defines the name of each vector 
vname cin A[31:28] A[27:24] A[23:20] A[19:16] A[15:12] A[11:8] A[7:4] A[3:0]
+     B[31:28] B[27:24] B[23:20] B[19:16] B[15:12] B[11:8] B[7:4] B[3:0]
+     sout[31:28] sout[27:24] sout[23:20] sout[19:16] sout[15:12] sout[11:8]
+     sout[7:4] sout[3:0] cout
; Define the type of each vector: input(i), output(o)
io iiiiiiiiiiiiiiiiiooooooooo
; Defines the time unit in the digital vector file
tunit ns
; Input delay
idelay 2.0
; Output delay
odelay 5.0
; Specifies the rising and falling time for the input signal
slope 0.1
; Specifies the logic high voltage and logic low voltage for the input signals
vih 1.8
vil 0.0
; defines the time interval the tabular data section
period 10.0
;====tabular data section=========
